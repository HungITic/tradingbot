# ============================================
# Trading Bot V1 - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ---- Application ----
DEBUG=false
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading_bot

# ---- Telegram Personal Bot ----
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ADMIN_CHAT_ID=your-personal-chat-id

# ---- Telegram Signal Listener (Telethon / Userbot) ----
TELEGRAM_API_ID=your-api-id-from-my-telegram-org
TELEGRAM_API_HASH=your-api-hash-from-my-telegram-org
TELEGRAM_SIGNAL_CHAT_ID=signal-group-chat-id

# ---- MetaTrader 5 ----
MT5_PATH=
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT=10000

# ---- Trading Defaults ----
TRADING_ENABLED=true
TRADING_MAX_OPEN_POSITIONS=5
TRADING_MAX_LOT=0.05
TRADING_MIN_LOT=0.01
TRADING_DEFAULT_LOT=0.01
TRADING_MAX_DAILY_LOSS_PERCENT=10.0
TRADING_REQUIRE_SL=true
TRADING_REQUIRE_TP=false
TRADING_ALLOWED_SYMBOLS=XAUUSD
TRADING_SIGNAL_EXPIRE_SECONDS=300
TRADING_DUPLICATE_TIMEOUT_SECONDS=600
